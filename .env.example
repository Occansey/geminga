# Copy to .env and fill in. Never commit .env.

# --- Model -------------------------------------------------------------
# Two ways to reach Gemini. Vertex AI is the one the hackathon rules
# recognise as "Google Cloud infrastructure", so prefer it for submission.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Gemini 3.x is served from the *global* endpoint. us-central1 404s for 3.5/3.6.
GOOGLE_CLOUD_LOCATION=global

# Only needed when GOOGLE_GENAI_USE_VERTEXAI=false (local dev, AI Studio key)
GOOGLE_API_KEY=

# Rules require Gemini 3.5 or newer. Flash shipped at I/O on 19 May 2026 and is
# generally available; gemini-3.5-pro was still allowlist-only Vertex preview as
# of late July 2026, so it is not the default. Request allowlist access and swap
# AGENT_MODEL if you have it. Confirm ids with:
#   gcloud ai models list --region=$GOOGLE_CLOUD_LOCATION
AGENT_MODEL=gemini-3.5-flash
AGENT_FAST_MODEL=gemini-3.5-flash

# --- Persistence -------------------------------------------------------
# firestore | memory   (memory is for tests only — Cloud Run instances die)
AGENT_STORE=firestore
AGENT_BUCKET=your-project-agent-artifacts

# --- Behaviour ---------------------------------------------------------
AGENT_NAME=taskmaster
AGENT_MAX_STEPS=12
# Set true for the Collaborative Partner framing: pause for approval
# before any step marked as having side effects.
AGENT_REQUIRE_APPROVAL=false

# --- Optional tool providers ------------------------------------------
# Reused by the DevNetwork SerpApi challenge ($3,000)
SERPAPI_KEY=
